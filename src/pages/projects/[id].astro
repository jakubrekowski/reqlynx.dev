---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { id } = Astro.params;
const project = projects.find((p) => p.id === id);

if (!project) {
  return Astro.redirect('/404');
}

const others = projects.filter((p) => p.id !== project.id).slice(0, 2);
const nameHtml = project.name.replace(/—/g, '<span class="brace">—</span>');
---
<Base title={`${project.name} · ReqLynx Digitalworks`}>
  <Nav linkPrefix="/" />
  <main>
    <section class="detail-hero shell" data-screen-label="Detail Hero">
      <div class="crumbs">
        <a href="/">~/reqlynx</a>
        <span class="sep">/</span>
        <a href="/#work">work</a>
        <span class="sep">/</span>
        <span class="green">{project.id}</span>
      </div>
      <div class="eyebrow">// project [ {project.num} ]</div>
      <h1 set:html={nameHtml} />
      <p style="font-size:20px;max-width:62ch;color:var(--ink-dim)">{project.summary}</p>
      <div class="detail-meta">
        <div class="item"><div class="lbl">Client</div><div class="val">{project.org}</div></div>
        <div class="item"><div class="lbl">Year</div><div class="val">{project.year}</div></div>
        <div class="item"><div class="lbl">Role</div><div class="val">{project.role}</div></div>
        <div class="item"><div class="lbl">Status</div><div class="val"><span style="color:var(--acc)">●</span> Shipped</div></div>
      </div>
    </section>

    <section class="shell">
      <div class="detail-grid">
        <div>
          <h2>Overview</h2>
          <p>{project.overview ?? project.summary}</p>

          {project.screenshots && project.screenshots.length > 0 ? (
            <div class="project-gallery">
              {project.screenshots.map((src, index) => (
                <div class="gallery-item">
                  <img src={src} alt={`${project.name} screenshot ${index + 1}`} loading="lazy" />
                  <div class="gallery-frame"></div>
                </div>
              ))}
            </div>
          ) : (
            <div class="placeholder-img" aria-hidden="true">
              <span>// product shot — to be added</span>
            </div>
          )}

          <h2>The brief</h2>
          <p>{project.challenge ?? '—'}</p>

          <h2>Approach</h2>
          <p>{project.solution ?? '—'}</p>


          <h2>What it does</h2>
          <ul>
            {(project.features ?? []).map((f) => <li>{f}</li>)}
          </ul>

          <h2>Notes</h2>
          <p>This page is a living writeup. As the project evolves I'll fill in the screenshots and a more detailed account of the trade-offs that shaped it. Reach out if you want a deeper walkthrough of any particular system.</p>
        </div>

        <aside class="side">
          <h4>// project info</h4>
          <div class="row"><span class="k">Client</span><span class="v">{project.org}</span></div>
          <div class="row"><span class="k">Year</span><span class="v">{project.year}</span></div>
          <div class="row"><span class="k">Role</span><span class="v">{project.role}</span></div>
          <div class="row"><span class="k">Status</span><span class="v">Shipped</span></div>
          <div class="row"><span class="k">Type</span><span class="v">Production</span></div>

          <h4 style="margin-top:28px">// stack</h4>
          <div class="tags">
            {project.tags.map((t) => <span class="tag">{t}</span>)}
          </div>

          <h4 style="margin-top:28px">// links</h4>
          <div class="row">
            <span class="k">Live</span>
            <span class="v">
              {project.link ? (
                <a href={project.link} target="_blank" rel="noopener noreferrer" style="color:var(--acc)">
                  visit site <span class="arrow" style="font-size: 0.8em;">↗</span>
                </a>
              ) : (
                <span class="dim">on request</span>
              )}
            </span>
          </div>
          <div class="row"><span class="k">Source</span><span class="v dim">private</span></div>

          <a href="/#contact" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:24px">Start a project <span class="arrow">↗</span></a>
        </aside>
      </div>
    </section>

    <section class="shell next-projects">
      <h3>// other work</h3>
      <div class="next-grid">
        {others.map((p) => <ProjectCard project={p} span="" />)}
      </div>
    </section>
  </main>
  <Footer variant="detail" />
  <style>
    .project-gallery {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      margin: 40px 0 64px;
    }
    
    @media (max-width: 720px) {
      .project-gallery {
        gap: 24px;
        margin: 32px 0 48px;
      }
    }
  </style>
</Base>
