---
interface Props {
  screenshots: string[];
}
const { screenshots } = Astro.props;
---

<div class="project-gallery">
  {screenshots.map((src, index) => (
    <div class="gallery-item">
      <img src={src} alt={`Project screenshot ${index + 1}`} loading="lazy" />
      <div class="gallery-frame"></div>
    </div>
  ))}
</div>

<style>
  .project-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin: 40px 0 64px;
  }
  
  @media (max-width: 720px) {
    .project-gallery {
      gap: 24px;
      margin: 32px 0 48px;
    }
  }
</style>
