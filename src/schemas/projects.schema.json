{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projects.schema.json",
  "title": "Projects",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "num", "name", "org", "year", "role", "summary", "tags"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "num": { "type": "string" },
      "name": { "type": "string" },
      "org": { "type": "string" },
      "year": { "type": "string" },
      "role": { "type": "string" },
      "summary": { "type": "string" },
      "tags": { "type": "array", "items": { "type": "string" } },
      "span": { "type": "string", "enum": ["span-3", "span-4", "span-6", "span-8", "span-12"] },
      "featured": { "type": "boolean" },
      "overview": { "type": "string" },
      "challenge": { "type": "string" },
      "solution": { "type": "string" },
      "features": { "type": "array", "items": { "type": "string" } }
    }
  }
}
